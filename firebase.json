{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "README.md",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "desktop.ini",
      "originales/**",
      "*.PNG",
      "*.JPG",
      "inventario.png"
    ],
    "cleanUrls": false,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
